{
    "interface_version": 2,
    "name": "FGO",
    "label": "命运-冠位指定",
    "description": "《命运-冠位指定》日常自动化脚本",
    "version": "1.1.2",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "进入游戏",
            "entry": "是否需要启动游戏",
            "default_check": true,
            "option": [
                "选择是否启动游戏"
            ],
            "description": "进入游戏主界面",
            "label": "进入游戏",
            "doc": "自动完成「进入游戏」。"
        },
        {
            "name": "领取邮箱奖励",
            "entry": "领取邮箱奖励开始",
            "default_check": true,
            "description": "进入邮箱，一键领取所有邮件奖励（除卡牌外内容）",
            "label": "领取邮箱奖励",
            "doc": "自动完成「领取邮箱奖励」。"
        },
        {
            "name": "刷体力",
            "entry": "刷体力开始",
            "default_check": true,
            "option": [
                "选择刷体力方式"
            ],
            "description": "消耗体力进行战斗",
            "label": "刷体力",
            "doc": "自动完成「刷体力」。"
        },
        {
            "name": "领取任务奖励",
            "entry": "领取任务奖励开始",
            "default_check": true,
            "description": "领取所有已完成的任务奖励",
            "label": "领取任务奖励",
            "doc": "自动完成「领取任务奖励」。"
        },
        {
            "name": "免费友情点召唤",
            "entry": "免费友情点召唤开始",
            "default_check": true,
            "description": "进入友情点卡池，执行每日免费的10连友情点召唤",
            "label": "免费友情点召唤",
            "doc": "自动完成「免费友情点召唤」。"
        },
        {
            "name": "免费召唤",
            "entry": "免费剧情召唤开始",
            "default_check": false,
            "description": "进入剧情卡池，执行每日免费的剧情召唤",
            "label": "免费召唤",
            "doc": "自动完成「免费召唤」。"
        },
        {
            "name": "重复刷关卡",
            "entry": "重复刷关卡开始",
            "default_check": false,
            "description": "连续重复刷同一关卡，直到体力不足或任务结束（使用时右下角应该有开始任务字符！）",
            "label": "重复刷关卡",
            "doc": "自动完成「重复刷关卡」。"
        },
        {
            "name": "自动推图",
            "entry": "推图开始",
            "default_check": false,
            "option": [
                "选择自动战斗模式"
            ],
            "description": "自动推进主线/活动关卡，包括选择关卡、跳过剧情、战斗、助战选择等全流程；但是bug很多",
            "label": "自动推图",
            "doc": "自动完成「自动推图」。"
        }
    ],
    "option": {
        "选择是否启动游戏": {
            "type": "select",
            "label": "选择是否启动游戏",
            "description": "选择进入游戏任务是否自动启动FGO",
            "default_case": "启动游戏",
            "cases": [
                {
                    "name": "启动游戏",
                    "label": "启动游戏",
                    "pipeline_override": {
                        "是否需要启动游戏": {
                            "next": [
                                "需要启动游戏"
                            ]
                        }
                    }
                },
                {
                    "name": "不启动游戏",
                    "label": "不启动游戏（游戏已在后台）",
                    "pipeline_override": {
                        "是否需要启动游戏": {
                            "next": [
                                "不需要启动游戏"
                            ]
                        }
                    }
                }
            ]
        },
        "选择刷体力方式": {
            "type": "select",
            "label": "选择刷体力方式",
            "description": "选择刷体力方式",
            "default_case": "方式一正常刷关卡",
            "cases": [
                {
                    "name": "方式一正常刷关卡",
                    "label": "正常刷",
                    "option": [
                        "选择关卡类型"
                    ],
                    "pipeline_override": {
                        "刷体力方式": {
                            "next": [
                                "方式一正常刷关卡"
                            ]
                        }
                    }
                },
                {
                    "name": "方式二换青铜树苗",
                    "label": "换青铜树苗",
                    "pipeline_override": {
                        "刷体力方式": {
                            "next": [
                                "方式二换青铜树苗"
                            ]
                        }
                    }
                }
            ]
        },
        "选择关卡类型": {
            "type": "select",
            "label": "选择关卡类型",
            "description": "选择要刷的关卡类型",
            "default_case": "搜集种火",
            "cases": [
                {
                    "name": "搜集种火",
                    "label": "搜集种火",
                    "option": [
                        "选择种火等级"
                    ],
                    "pipeline_override": {
                        "判断打哪个类型开始": {
                            "next": [
                                "搜集种火",
                                "[JumpBack]滑动关卡界面"
                            ]
                        }
                    }
                },
                {
                    "name": "修炼场",
                    "label": "修炼场",
                    "option": [
                        "选择修炼场等级"
