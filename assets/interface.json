{
    "interface_version": 2,
    "name": "MAA-E7-Resonance",
    "description": "《雷索纳斯》自动化脚本 - 整合日常任务流程",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用雷索纳斯自动化助手，只可以完成日常欧~",
    "version": "1.0.0",

    "controller": [
        {
            "name": "Android",
            "label": "$安卓端",
            "description": "通过 ADB 连接安卓设备",
            "type": "Adb",
            "display_short_side": 720
        }
    ],

    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],

    "task": [
        {
            "name": "🚀 登录游戏",
            "entry": "登陆游戏开始",
            "description": "自动处理游戏启动、更新和登录流程（需在游戏界面外启动）"
        },
        {
            "name": "📬 派遣委托",
            "entry": "派遣任务开始",
            "description": "自动收取并重新派遣已完成的任务"
        },
        {
            "name": "⚔️ 刷行动汇总",
            "entry": "每日刷行动汇总开始",
            "description": "自动刷取指定的关卡类型及具体关卡（只用扫荡方式）",
            "option": ["刷体力关卡类型", "刷体力具体关卡"]
        },
        {
            "name": "📘 环游手册奖励领取",
            "entry": "环游手册奖励领取",
            "description": "自动领取环游手册中的任务积分奖励和等级奖励"
        },
        {
            "name": "🎯 每日活跃度",
            "entry": "领取每日活跃度奖励开始",
            "description": "自动领取每日活跃度任务和累积奖励"
        }
    ],

    "option": {
        "刷体力关卡类型": {
            "type": "select",
            "label": "关卡类型",
            "description": "选择要刷取的关卡类型",
            "default_case": "利刃围剿",
            "cases": [
                {
                    "name": "利刃围剿",
                    "label": "利刃围剿",
                    "description": "刷取利刃围剿类型关卡",
                    "option": ["刷体力具体关卡-利刃围剿"],
                    "pipeline_override": {
                        "开始第一次关卡类型选择": {
                            "next": ["选择利刃围剿类型"]
                        }
                    }
                },
                {
                    "name": "全境特供",
                    "label": "全境特供",
                    "description": "刷取全境特供类型关卡",
                    "option": ["刷体力具体关卡-全境特供"],
                    "pipeline_override": {
                        "开始第一次关卡类型选择": {
                            "next": ["选择全境特供类型"]
                        }
                    }
                },
                {
                    "name": "私贩追缴",
                    "label": "私贩追缴",
                    "description": "刷取私贩追缴类型关卡",
                    "option": ["刷体力具体关卡-私贩追缴"],
                    "pipeline_override": {
                        "开始第一次关卡类型选择": {
                            "next": ["选择私贩追缴类型"]
                        }
                    }
                }
            ]
        },
        "刷体力具体关卡-利刃围剿": {
            "type": "select",
            "label": "具体关卡",
            "description": "选择利刃围剿下的具体关卡",
            "default_case": "特殊订单",
            "cases": [
                {
                    "name": "特殊订单",
                    "label": "特殊订单",
                    "description": "刷取特殊订单关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-特殊订单"]
                        }
                    }
                },
                {
                    "name": "利刃行动",
                    "label": "利刃行动",
                    "description": "刷取利刃行动关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-利刃行动"]
                        }
                    }
                },
                {
                    "name": "挑灯看剑",
                    "label": "挑灯看剑",
                    "description": "刷取挑灯看剑关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-挑灯看剑"]
                        }
                    }
                },
                {
                    "name": "武器材质分析",
                    "label": "武器材质分析",
                    "description": "刷取武器材质分析关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-武器材质分析"]
                        }
                    }
                },
                {
                    "name": "骑士小说",
                    "label": "骑士小说",
                    "description": "刷取骑士小说关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-骑士小说"]
                        }
                    }
                },
                {
                    "name": "我思我在",
                    "label": "我思我在",
                    "description": "刷取我思我在关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-我思我在"]
                        }
                    }
                },
                {
                    "name": "所知所闻",
                    "label": "所知所闻",
                    "description": "刷取所知所闻关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-所知所闻"]
                        }
                    }
                },
                {
                    "name": "大的",
                    "label": "大的",
                    "description": "刷取大的关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-大的"]
                        }
                    }
                },
                {
                    "name": "总体围剿",
                    "label": "总体围剿",
                    "description": "刷取总体围剿关卡",
                    "pipeline_override": {
                        "利刃围剿类型关卡选择": {
                            "next": ["选择关卡-总体围剿"]
                        }
                    }
                }
            ]
        },
        "刷体力具体关卡-全境特供": {
            "type": "select",
            "label": "具体关卡",
            "description": "选择全境特供下的具体关卡",
            "default_case": "默认第一个关卡",
            "cases": [
                {
                    "name": "默认第一个关卡",
                    "label": "默认第一个关卡",
                    "description": "优先选择第一个关卡",
                    "pipeline_override": {
                        "全境特供类型关卡选择": {
                            "next": ["优先选择第一个关卡-全境特供类型关卡"]
                        }
                    }
                }
            ]
        },
        "刷体力具体关卡-私贩追缴": {
            "type": "select",
            "label": "具体关卡",
            "description": "选择私贩追缴下的具体关卡",
            "default_case": "特供盲盒",
            "cases": [
                {
                    "name": "特供盲盒",
                    "label": "特供盲盒",
                    "description": "刷取特供·盲盒关卡",
                    "pipeline_override": {
                        "私贩追缴类型关卡选择": {
                            "next": ["选择关卡-特供盲盒"]
                        }
                    }
                }
            ]
        }
    }
}